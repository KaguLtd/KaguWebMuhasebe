generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  TRY
  USD
  EUR
  GBP
}

enum AccountKind {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum InvoiceKind {
  SALES
  PURCHASE
}

enum InvoiceType {
  STANDARD
  STAR
}

enum DeliveryDirection {
  IN
  OUT
}

enum DeliveryMergeRole {
  NORMAL
  MERGED_RESULT
  MERGED_SOURCE
}

enum ReceiptKind {
  COLLECTION
  PAYMENT
}

enum DocumentStatus {
  DRAFT
  APPROVED
  VOID
  SUPERSEDED
}

enum StockCountStatus {
  DRAFT
  FINISHED
  VOID
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model User {
  id                   String            @id @default(uuid())
  username             String            @unique
  email                String?           @unique
  displayName          String            @map("display_name")
  passwordHash         String            @map("password_hash")
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  roles                UserRole[]
  sessions             Session[]
  auditEvents          AuditEvent[]      @relation("AuditEventActor")
  loginAttempts        LoginAttempt[]
  loginLockout         UserLoginLockout?
  changedDeliveryNotes DeliveryNote[]    @relation("DeliveryNoteChangedByUser")
  changedInvoices      Invoice[]         @relation("InvoiceChangedByUser")
  changedReceipts      Receipt[]         @relation("ReceiptChangedByUser")
  changedTransfers     Transfer[]        @relation("TransferChangedByUser")

  @@map("users")
}

model Role {
  id                     String           @id @default(uuid())
  key                    String           @unique
  description            String?
  isSystem               Boolean          @default(false) @map("is_system")
  requiresUserAssignment Boolean          @default(false) @map("requires_user_assignment")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  users                  UserRole[]
  permissions            RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model DocumentCounter {
  docType   String   @map("doc_type")
  year      Int
  nextSeq   Int      @default(1) @map("next_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([docType, year])
  @@map("document_counters")
}

model DocumentNumberRegistry {
  id        String   @id @default(uuid())
  docType   String   @map("doc_type")
  docId     String   @map("doc_id")
  docNo     String   @map("doc_no")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([docType, docId])
  @@unique([docType, docNo])
  @@map("document_number_registry")
}

model DocumentRevision {
  id         String   @id @default(uuid())
  docType    String   @map("doc_type")
  docId      String   @map("doc_id")
  revisionNo Int      @default(1) @map("revision_no")
  reason     String?
  payload    Json?
  editedAt   DateTime @default(now()) @map("edited_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([docType, docId])
  @@map("document_revisions")
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  entity      String
  entityId    String   @map("entity_id")
  action      String
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  actorUser   User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@map("audit_events")
}

model LoginAttempt {
  id            String   @id @default(uuid())
  username      String
  userId        String?  @map("user_id")
  wasSuccessful Boolean  @default(false) @map("was_successful")
  failureReason String?  @map("failure_reason")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([username, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

model UserLoginLockout {
  userId           String    @id @map("user_id")
  failedAttempts   Int       @default(0) @map("failed_attempts")
  lockedUntil      DateTime? @map("locked_until")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  lastFailedAt     DateTime? @map("last_failed_at")
  lastSuccessfulAt DateTime? @map("last_successful_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_login_lockouts")
}

model Account {
  id                   String               @id @default(uuid())
  code                 String               @unique
  name                 String
  accountKind          AccountKind          @default(CUSTOMER) @map("account_kind")
  currency             Currency             @default(TRY)
  isActive             Boolean              @default(true) @map("is_active")
  activeBalanceMinor   Int                  @default(0) @map("active_balance_minor")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  projects             Project[]
  deliveryNotes        DeliveryNote[]
  invoices             Invoice[]
  receipts             Receipt[]
  transfersFrom        Transfer[]           @relation("TransferFromAccount")
  transfersTo          Transfer[]           @relation("TransferToAccount")
  ledgerEntries        AccountLedgerEntry[] @relation("AccountLedgerAccount")
  relatedLedgerEntries AccountLedgerEntry[] @relation("AccountLedgerRelatedAccount")

  @@map("accounts")
}

model Project {
  id             String               @id @default(uuid())
  accountId      String               @map("account_id")
  code           String               @unique
  name           String
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  deliveryNotes  DeliveryNote[]
  invoices       Invoice[]
  receipts       Receipt[]
  transfers      Transfer[]
  stockCounts    StockCount[]
  ledgerEntries  AccountLedgerEntry[]
  stockMovements StockMovement[]

  @@index([accountId])
  @@map("projects")
}

model Warehouse {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deliveryNotes  DeliveryNote[]
  invoices       Invoice[]
  stockCounts    StockCount[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

model Unit {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  items     Item[]

  @@map("units")
}

model ItemClass {
  id        String   @id @default(uuid()) @map("id")
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  items     Item[]

  @@map("item_classes")
}

model VatRate {
  id        String   @id @default(uuid())
  rateBps   Int      @unique @map("rate_bps")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  items     Item[]

  @@map("vat_rates")
}

model Item {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  unitId            String             @map("unit_id")
  classId           String             @map("class_id")
  defaultVatRateId  String             @map("default_vat_rate_id")
  isActive          Boolean            @default(true) @map("is_active")
  totalStock        Decimal            @default(0) @map("total_stock") @db.Decimal(18, 4)
  averageCostMinor  Int                @default(0) @map("average_cost_minor")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  unit              Unit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  itemClass         ItemClass          @relation(fields: [classId], references: [id], onDelete: Restrict)
  defaultVatRate    VatRate            @relation(fields: [defaultVatRateId], references: [id], onDelete: Restrict)
  deliveryNoteLines DeliveryNoteLine[]
  invoiceLines      InvoiceLine[]
  stockCountLines   StockCountLine[]
  stockMovements    StockMovement[]

  @@index([unitId])
  @@index([classId])
  @@index([defaultVatRateId])
  @@map("items")
}

model DeliveryNote {
  id               String             @id @default(uuid())
  docNo            String             @unique @map("doc_no")
  actualDocNo      String?            @map("actual_doc_no")
  direction        DeliveryDirection
  mergeRole        DeliveryMergeRole  @default(NORMAL) @map("merge_role")
  isReturn         Boolean            @default(false) @map("is_return")
  accountId        String             @map("account_id")
  projectId        String?            @map("project_id")
  warehouseId      String             @map("warehouse_id")
  docDate          DateTime           @map("doc_date")
  status           DocumentStatus     @default(DRAFT)
  isEffective      Boolean            @default(true) @map("is_effective")
  supersedesId     String?            @map("supersedes_id")
  supersededById   String?            @map("superseded_by_id")
  supersededAt     DateTime?          @map("superseded_at")
  invoicedByInvoiceId String?          @map("invoiced_by_invoice_id")
  invoicedAt       DateTime?          @map("invoiced_at")
  changeNote       String?            @map("change_note")
  changedByUserId  String?            @map("changed_by_user_id")
  description      String?
  voidReason       String?            @map("void_reason")
  approvedAt       DateTime?          @map("approved_at")
  voidedAt         DateTime?          @map("voided_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supersedes       DeliveryNote?      @relation("DeliveryNoteSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     DeliveryNote?      @relation("DeliveryNoteSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  invoicedByInvoice Invoice?           @relation("DeliveryNoteInvoicedByInvoice", fields: [invoicedByInvoiceId], references: [id], onDelete: SetNull)
  changedByUser    User?              @relation("DeliveryNoteChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  supersedingNotes DeliveryNote[]     @relation("DeliveryNoteSupersedes")
  supersededNotes  DeliveryNote[]     @relation("DeliveryNoteSupersededBy")
  lines            DeliveryNoteLine[]
  mergeSources     DeliveryNoteMergeSource[] @relation("MergedDeliveryNoteSources")
  usedAsMergeSource DeliveryNoteMergeSource[] @relation("SourceDeliveryNoteMerges")

  @@index([accountId])
  @@index([projectId])
  @@index([warehouseId])
  @@index([status])
  @@index([isEffective, status])
  @@index([supersedesId])
  @@index([supersededById])
  @@index([invoicedByInvoiceId])
  @@index([changedByUserId])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id              String        @id @default(uuid())
  deliveryNoteId  String        @map("delivery_note_id")
  itemId          String        @map("item_id")
  description     String?
  quantity        Decimal       @db.Decimal(18, 4)
  unitPriceMinor  Int           @default(0) @map("unit_price_minor")
  currency        Currency      @default(TRY)
  vatRateBps      Int           @default(0) @map("vat_rate_bps")
  lineTotalMinor  Int           @default(0) @map("line_total_minor")
  netTotalMinor   Int           @default(0) @map("net_total_minor")
  vatTotalMinor   Int           @default(0) @map("vat_total_minor")
  grossTotalMinor Int           @default(0) @map("gross_total_minor")
  deliveryNote    DeliveryNote  @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  invoiceLines    InvoiceLine[]
  mergedLineSources DeliveryNoteLineSource[] @relation("MergedDeliveryNoteLineSources")
  usedAsLineSource  DeliveryNoteLineSource[] @relation("SourceDeliveryNoteLineSources")

  @@index([deliveryNoteId])
  @@index([itemId])
  @@map("delivery_note_lines")
}

model DeliveryNoteMergeSource {
  id                   String       @id @default(uuid())
  mergedDeliveryNoteId String       @map("merged_delivery_note_id")
  sourceDeliveryNoteId String       @map("source_delivery_note_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  mergedDeliveryNote   DeliveryNote @relation("MergedDeliveryNoteSources", fields: [mergedDeliveryNoteId], references: [id], onDelete: Cascade)
  sourceDeliveryNote   DeliveryNote @relation("SourceDeliveryNoteMerges", fields: [sourceDeliveryNoteId], references: [id], onDelete: Restrict)

  @@unique([mergedDeliveryNoteId, sourceDeliveryNoteId])
  @@index([sourceDeliveryNoteId])
  @@map("delivery_note_merge_sources")
}

model DeliveryNoteLineSource {
  id                       String           @id @default(uuid())
  deliveryNoteLineId       String           @map("delivery_note_line_id")
  sourceDeliveryNoteLineId String           @map("source_delivery_note_line_id")
  signedQuantity           Decimal          @map("signed_quantity") @db.Decimal(18, 4)
  createdAt                DateTime         @default(now()) @map("created_at")
  deliveryNoteLine         DeliveryNoteLine @relation("MergedDeliveryNoteLineSources", fields: [deliveryNoteLineId], references: [id], onDelete: Cascade)
  sourceDeliveryNoteLine   DeliveryNoteLine @relation("SourceDeliveryNoteLineSources", fields: [sourceDeliveryNoteLineId], references: [id], onDelete: Restrict)

  @@unique([deliveryNoteLineId, sourceDeliveryNoteLineId])
  @@index([sourceDeliveryNoteLineId])
  @@map("delivery_note_line_sources")
}

model Invoice {
  id                  String         @id @default(uuid())
  docNo               String         @unique @map("doc_no")
  actualDocNo         String?        @map("actual_doc_no")
  invoiceKind         InvoiceKind    @map("invoice_kind")
  invoiceType         InvoiceType    @default(STANDARD) @map("invoice_type")
  accountId           String         @map("account_id")
  projectId           String?        @map("project_id")
  warehouseId         String?        @map("warehouse_id")
  docDate             DateTime       @map("doc_date")
  currency            Currency       @default(TRY)
  exchangeRate        Decimal        @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  discountBps         Int            @default(0) @map("discount_bps")
  netTotalMinor       Int            @default(0) @map("net_total_minor")
  vatTotalMinor       Int            @default(0) @map("vat_total_minor")
  documentTotalMinor  Int            @default(0) @map("document_total_minor")
  status              DocumentStatus @default(DRAFT)
  isEffective         Boolean        @default(true) @map("is_effective")
  supersedesId        String?        @map("supersedes_id")
  supersededById      String?        @map("superseded_by_id")
  supersededAt        DateTime?      @map("superseded_at")
  changeNote          String?        @map("change_note")
  changedByUserId     String?        @map("changed_by_user_id")
  description         String?
  voidReason          String?        @map("void_reason")
  approvedAt          DateTime?      @map("approved_at")
  voidedAt            DateTime?      @map("voided_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  account             Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  warehouse           Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  supersedes          Invoice?       @relation("InvoiceSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy        Invoice?       @relation("InvoiceSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  changedByUser       User?          @relation("InvoiceChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  supersedingInvoices Invoice[]      @relation("InvoiceSupersedes")
  supersededInvoices  Invoice[]      @relation("InvoiceSupersededBy")
  invoicedDeliveryNotes DeliveryNote[] @relation("DeliveryNoteInvoicedByInvoice")
  lines               InvoiceLine[]

  @@index([accountId])
  @@index([projectId])
  @@index([warehouseId])
  @@index([status])
  @@index([isEffective, status])
  @@index([supersedesId])
  @@index([supersededById])
  @@index([changedByUserId])
  @@map("invoices")
}

model InvoiceLine {
  id                    String            @id @default(uuid())
  invoiceId             String            @map("invoice_id")
  deliveryNoteLineId    String?           @map("delivery_note_line_id")
  itemId                String            @map("item_id")
  description           String?
  quantity              Decimal           @db.Decimal(18, 4)
  unitPriceMinor        Int               @default(0) @map("unit_price_minor")
  discountBps           Int               @default(0) @map("discount_bps")
  vatRateBps            Int               @default(0) @map("vat_rate_bps")
  lineTotalMinor        Int               @default(0) @map("line_total_minor")
  netTotalMinor         Int               @default(0) @map("net_total_minor")
  vatTotalMinor         Int               @default(0) @map("vat_total_minor")
  grossTotalMinor       Int               @default(0) @map("gross_total_minor")
  sourceDeliveryLineIds String[]          @default([]) @map("source_delivery_line_ids")
  invoice               Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliveryNoteLine      DeliveryNoteLine? @relation(fields: [deliveryNoteLineId], references: [id], onDelete: SetNull)
  item                  Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([deliveryNoteLineId])
  @@index([itemId])
  @@map("invoice_lines")
}

model Receipt {
  id                  String         @id @default(uuid())
  docNo               String         @unique @map("doc_no")
  receiptKind         ReceiptKind    @map("receipt_kind")
  accountId           String         @map("account_id")
  projectId           String?        @map("project_id")
  docDate             DateTime       @map("doc_date")
  amountMinor         Int            @map("amount_minor")
  currency            Currency       @default(TRY)
  description         String?
  voidReason          String?        @map("void_reason")
  status              DocumentStatus @default(DRAFT)
  isEffective         Boolean        @default(true) @map("is_effective")
  supersedesId        String?        @map("supersedes_id")
  supersededById      String?        @map("superseded_by_id")
  supersededAt        DateTime?      @map("superseded_at")
  changeNote          String?        @map("change_note")
  changedByUserId     String?        @map("changed_by_user_id")
  approvedAt          DateTime?      @map("approved_at")
  voidedAt            DateTime?      @map("voided_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  account             Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supersedes          Receipt?       @relation("ReceiptSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy        Receipt?       @relation("ReceiptSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  changedByUser       User?          @relation("ReceiptChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  supersedingReceipts Receipt[]      @relation("ReceiptSupersedes")
  supersededReceipts  Receipt[]      @relation("ReceiptSupersededBy")

  @@index([accountId])
  @@index([projectId])
  @@index([status])
  @@index([isEffective, status])
  @@index([supersedesId])
  @@index([supersededById])
  @@index([changedByUserId])
  @@map("receipts")
}

model Transfer {
  id                   String         @id @default(uuid())
  docNo                String         @unique @map("doc_no")
  fromAccountId        String         @map("from_account_id")
  toAccountId          String         @map("to_account_id")
  projectId            String?        @map("project_id")
  docDate              DateTime       @map("doc_date")
  amountMinor          Int            @map("amount_minor")
  currency             Currency       @default(TRY)
  crossRate            Decimal        @default(1) @map("cross_rate") @db.Decimal(18, 6)
  targetAmountMinor    Int?           @map("target_amount_minor")
  description          String?
  voidReason           String?        @map("void_reason")
  status               DocumentStatus @default(DRAFT)
  isEffective          Boolean        @default(true) @map("is_effective")
  supersedesId         String?        @map("supersedes_id")
  supersededById       String?        @map("superseded_by_id")
  supersededAt         DateTime?      @map("superseded_at")
  changeNote           String?        @map("change_note")
  changedByUserId      String?        @map("changed_by_user_id")
  approvedAt           DateTime?      @map("approved_at")
  voidedAt             DateTime?      @map("voided_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  fromAccount          Account        @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount            Account        @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  project              Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supersedes           Transfer?      @relation("TransferSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy         Transfer?      @relation("TransferSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  changedByUser        User?          @relation("TransferChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  supersedingTransfers Transfer[]     @relation("TransferSupersedes")
  supersededTransfers  Transfer[]     @relation("TransferSupersededBy")

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([projectId])
  @@index([status])
  @@index([isEffective, status])
  @@index([supersedesId])
  @@index([supersededById])
  @@index([changedByUserId])
  @@map("transfers")
}

model StockCount {
  id          String           @id @default(uuid())
  docNo       String           @unique @map("doc_no")
  warehouseId String           @map("warehouse_id")
  projectId   String?          @map("project_id")
  docDate     DateTime         @map("doc_date")
  status      StockCountStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lines       StockCountLine[]

  @@index([warehouseId])
  @@index([projectId])
  @@index([status])
  @@map("stock_counts")
}

model StockCountLine {
  id           String     @id @default(uuid())
  stockCountId String     @map("stock_count_id")
  itemId       String     @map("item_id")
  expectedQty  Decimal    @default(0) @map("expected_qty") @db.Decimal(18, 4)
  countedQty   Decimal    @default(0) @map("counted_qty") @db.Decimal(18, 4)
  difference   Decimal    @default(0) @db.Decimal(18, 4)
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([stockCountId])
  @@index([itemId])
  @@map("stock_count_lines")
}

model AccountLedgerEntry {
  id               String    @id @default(uuid())
  accountId        String    @map("account_id")
  relatedAccountId String?   @map("related_account_id")
  projectId        String?   @map("project_id")
  docType          String    @map("doc_type")
  docId            String    @map("doc_id")
  docNo            String    @map("doc_no")
  docDate          DateTime  @map("doc_date")
  debitMinor       Int       @default(0) @map("debit_minor")
  creditMinor      Int       @default(0) @map("credit_minor")
  currency         Currency  @default(TRY)
  description      String?
  isEffective      Boolean   @default(true) @map("is_effective")
  cancelledAt      DateTime? @map("cancelled_at")
  replacedByDocId  String?   @map("replaced_by_doc_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  account          Account   @relation("AccountLedgerAccount", fields: [accountId], references: [id], onDelete: Restrict)
  relatedAccount   Account?  @relation("AccountLedgerRelatedAccount", fields: [relatedAccountId], references: [id], onDelete: SetNull)
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([relatedAccountId])
  @@index([projectId])
  @@index([isEffective, docDate])
  @@index([replacedByDocId])
  @@index([docType, docId])
  @@map("account_ledger_entries")
}

model StockMovement {
  id              String    @id @default(uuid())
  warehouseId     String    @map("warehouse_id")
  itemId          String    @map("item_id")
  projectId       String?   @map("project_id")
  docType         String    @map("doc_type")
  docId           String    @map("doc_id")
  docNo           String    @map("doc_no")
  docDate         DateTime  @map("doc_date")
  qtyIn           Decimal   @default(0) @map("qty_in") @db.Decimal(18, 4)
  qtyOut          Decimal   @default(0) @map("qty_out") @db.Decimal(18, 4)
  isEffective     Boolean   @default(true) @map("is_effective")
  cancelledAt     DateTime? @map("cancelled_at")
  replacedByDocId String?   @map("replaced_by_doc_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item            Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([itemId])
  @@index([projectId])
  @@index([isEffective, docDate])
  @@index([replacedByDocId])
  @@index([docType, docId])
  @@map("stock_movements")
}
